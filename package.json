{
  "name": "wcag-cli",
  "version": "0.1.0",
  "description": "Token-efficient WCAG 2.2 exploration CLI and MCP server for AI agents and developers",
  "type": "module",
  "bin": {
    "wcag": "./dist/cli.js",
    "wcag-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "SKILL.md",
    "CONTEXT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-data": "tsx scripts/sync-data.ts",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run sync-data && npm run build && npm run test"
  },
  "keywords": [
    "wcag",
    "a11y",
    "accessibility",
    "cli",
    "mcp",
    "modelcontextprotocol",
    "ai-agents",
    "wcag22",
    "wai"
  ],
  "author": "Beka Westberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeksOmega/wcag-cli.git"
  },
  "bugs": {
    "url": "https://github.com/BeksOmega/wcag-cli/issues"
  },
  "homepage": "https://github.com/BeksOmega/wcag-cli#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "commander": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
